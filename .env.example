GOOGLE_OAUTH_CLIENT_ID=google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=google-oauth-client-secret
# Flask session signing. Generate one per environment:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-in-production
# Postgres connection. External hosts need ?sslmode=require appended.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/library_db
# Optional backup schedule overrides (defaults: day 1, 02:00, keep 12).
# BACKUP_DAY=1
# BACKUP_HOUR=2
# BACKUP_KEEP=12